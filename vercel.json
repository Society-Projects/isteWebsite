{
  "rewrites": [
    {
      "source": "/timetable",
      "destination": "https://timetable-2-0.vercel.app/"
    },
    {
      "source": "/timetable/:path*",
      "destination": "https://timetable-2-0.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}